# Production Environment Variables for Frontend (Vercel)
# Copy this to Vercel project settings and update with your actual backend URL

# Backend API URL - Update this with your deployed backend URL
# Examples:
# - Heroku: VITE_API_URL=https://your-app-name.herokuapp.com/api
# - Railway: VITE_API_URL=https://your-railway-app.up.railway.app/api
# - Render: VITE_API_URL=https://your-render-app.onrender.com/api
# - AWS: VITE_API_URL=https://your-api.example.com/api

VITE_API_URL=https://your-backend-url.com/api
