# Backend Environment Variables Template
# Copy this to .env and fill in your actual values

# Server Configuration
PORT=5000
NODE_ENV=production

# Database Configuration
# For local MongoDB:
# MONGODB_URI=mongodb://localhost:27017/cineverse

# For MongoDB Atlas (Cloud):
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/cineverse

# JWT Configuration
JWT_SECRET=your_very_secret_key_here_use_a_strong_random_string
JWT_EXPIRE=7d

# OMDb API Configuration
OMDB_API_KEY=your_omdb_api_key_here

# TMDB API Configuration
TMDB_API_KEY=your_tmdb_api_key_here

# CORS Configuration (for production deployment)
# Separate multiple URLs with commas, no spaces
ALLOWED_ORIGINS=https://your-vercel-app.vercel.app,https://your-domain.com,http://localhost:5173,http://localhost:3000

# Email Configuration (optional, for future features)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
